# Copy to .env and fill in. Vite only exposes variables prefixed VITE_ to client
# code — a NEXT_PUBLIC_ prefix (Next.js convention) is silently undefined here.
#
# Both values are safe in the client bundle: the publishable key carries no
# authority of its own, and Row Level Security is what actually protects the data.
# Anything that must stay secret (the service_role key) never belongs in this file.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
